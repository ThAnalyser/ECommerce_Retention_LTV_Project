# Data (large files — keep local only)
# ============================================
Data/raw/*.csv
Data/raw/*.xlsx
Data/processed/*.csv
Data/models/*.pkl

# But DO track the folder structure
!Data/raw/.gitkeep
!Data/processed/.gitkeep
!Data/models/.gitkeep

